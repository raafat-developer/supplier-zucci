# Zucci Supplier — Environment Variables
#
# Three environments (Vite --mode):
#   local/dev  → .env.development  → https://api.zucci.xyz  (same as staging)
#   staging    → .env.staging      → https://api.zucci.xyz
#   production → .env.production   → https://api.zucci.com
#
# Hostnames:
#   local      → https://supplier.zucci.local
#   staging    → https://supplier.zucci.xyz
#   production → https://supplier.zucci.com
#
# Copy this file to .env.local to override any value locally (gitignored).

VITE_APP_ENV=local
VITE_API_URL=/api/

# Real-time WebSockets (Laravel Reverb)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=api.zucci.xyz
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

